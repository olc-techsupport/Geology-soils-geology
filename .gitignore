__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/

# Generated notebook and download caches
Notebooks/cache/
.cache/
cache/
tmp/
temp/

# SQLite temporary files
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# Packaging and build outputs
build/
dist/
*.egg-info/

# IDE settings
.vscode/
.idea/

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.bak
~$*

# Large raw geology dataset
data/raw/geology/Shapefiles/Fault_Points.*
data/raw/geology/
data/raw/ssurgo/

# Generated analysis products (publish reviewed artifacts as release assets)
outputs/
!outputs/.gitkeep

# Governed Tribal data (deny by default)
# Public source data belongs under data/public/. Nation- or OLC-controlled
# records belong under data/governed/ and must never be committed.
data/governed/**
!data/governed/.gitkeep
data/raw/soil_profiles.csv
data/raw/soil_profiles.xlsx
data/raw/well_logs.csv
data/raw/well_logs.xlsx
data/raw/field_observations.csv
data/raw/field_observations.xlsx
data/raw/photos/
data/raw/gps/
